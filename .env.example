# Ready2Ship configuration. Copy to .env.local (dev) or set in your host's
# secret manager. Every variable is read at runtime; nothing is baked into
# the build, so one Docker image works for every deployment.

# ── Required ──────────────────────────────────────────────────────────────

# Public URL of this deployment, no trailing slash.
BASE_URL=http://localhost:3000

# Your GitHub App (see docs/self-host.md). The slug is the app's URL name:
# https://github.com/apps/<slug>
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Base64 of the .pem file (base64 -i app.pem | tr -d '\n') or the raw PEM.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

MONGODB_URI=mongodb://localhost:27017

# At least 32 characters: openssl rand -base64 48
SESSION_SECRET=
# Encrypts stored AI keys and GitHub tokens. 32 bytes, base64:
#   openssl rand -base64 32
# Back it up: if it is lost, every workspace must re-enter its AI key.
ENCRYPTION_KEY=

# Comma-separated Gemini model names, tried in order: if one fails (overloaded,
# unavailable) the next is used. The app refuses to start without it.
# Example: GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash
GEMINI_MODELS=

# ── Optional ──────────────────────────────────────────────────────────────

# Database name (default: ready2ship).
# MONGODB_DB=ready2ship

# Self-hosting only: an instance-wide Gemini key used by workspaces that have
# not added their own. Leave unset on a multi-tenant deployment.
# GEMINI_API_KEY=

# Restrict installation to these GitHub accounts (comma-separated logins).
# ALLOWED_GITHUB_ACCOUNTS=my-org

# GitHub Enterprise Server:
# GITHUB_API_URL=https://github.example.com/api/v3
# GITHUB_WEB_URL=https://github.example.com

# Link to the source code, shown in the UI. Point it at your fork if you run
# a modified version.
# SOURCE_CODE_URL=https://github.com/AbdullahG/ready2ship

# Webhook jobs processed in parallel by the worker inside the app (default 2).
# 0 turns the worker off; queued jobs wait until it's back.
# JOB_CONCURRENCY=2

# Per-request timeouts in milliseconds (defaults: 30000 and 120000).
# GITHUB_TIMEOUT_MS=30000
# GEMINI_TIMEOUT_MS=120000
